"""
Top header bar: brand title, Keithley/Relay status LEDs, connect button,
sample ID field, output-folder browse button, and the theme toggle.

Pure layout + labels/buttons, no custom paint/text logic.
"""
from enaml.core.api import d_
from enaml.layout.api import align, hbox, spacer
from enaml.widgets.api import Container, Field, Label, PushButton

from gui.effects import refresh_led_glow, set_status_led


enamldef HeaderPanel(Container): header:
    attr is_dark_mode: bool = False

    # --- Public API  ---
    event connect_clicked
    event browse_clicked
    event theme_toggled

    func sample_name():
        return sample_id_field.text.strip()

    func post_activate_setup():
        # Must run after activate_proxy() creates the real Qt widgets
        from PySide6.QtCore import Qt

        for led, lbl in ((keithley_led, keithley_lbl), (relay_led, relay_lbl)):
            led.proxy.widget.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)

        set_status_led(keithley_led.proxy.widget, keithley_lbl.proxy.widget, "idle")
        set_status_led(relay_led.proxy.widget, relay_lbl.proxy.widget, "idle")

        # connect_btn/browse_dir_btn's QSS-driven sizeHint (~34px) loses to
        # sibling widgets in Enaml's soft hug-priority constraint solver,
        # rendering at 22px -- verified by testing, not assumed. ThemeButton
        # doesn't have this problem because its QSS min/max-height (36px)
        # sets a hard Qt-level bound the solver always respects; giving
        # these two the same kind of hard bound (rather than a relational
        # Enaml constraint, which was tried first and didn't win the
        # priority conflict either) is the fix that actually held up.
        for btn in (connect_btn, browse_dir_btn):
            btn.proxy.widget.setMinimumHeight(38)

    func set_connection_status(keithley_ok, relay_ok, colors):
        set_status_led(keithley_led.proxy.widget, keithley_lbl.proxy.widget,
                        "ok" if keithley_ok else "bad")
        set_status_led(relay_led.proxy.widget, relay_lbl.proxy.widget,
                        "ok" if relay_ok else "bad")
        refresh_led_glow(keithley_led.proxy.widget, colors)
        refresh_led_glow(relay_led.proxy.widget, colors)
        connect_btn.text = "Reconnect"

    func set_running(running):
        connect_btn.enabled = not running
        browse_dir_btn.enabled = not running

    func apply_theme(colors, is_dark):
        header.is_dark_mode = is_dark
        theme_btn.text = "\u2600\ufe0f" if is_dark else "\U0001F319"
        refresh_led_glow(keithley_led.proxy.widget, colors)
        refresh_led_glow(relay_led.proxy.widget, colors)

    padding = (20, 8, 20, 8)
    constraints = [
        hbox(
            brand_title, keithley_led, keithley_lbl, relay_led, relay_lbl,
            connect_btn, spacer, sample_lbl, sample_id_field, browse_dir_btn,
            theme_btn, spacing=10,
        ),
        align("v_center", brand_title, keithley_led, keithley_lbl, relay_led,
              relay_lbl, connect_btn, sample_lbl, sample_id_field,
              browse_dir_btn, theme_btn),
        sample_id_field.width >= 220,
        sample_id_field.width <= 340,
    ]

    Label: brand_title:
        name = "BrandTitle"
        text = "MULTIPLEX SIM"

    Label: keithley_led:
        name = "StatusLED"
        text = ""

    Label: keithley_lbl:
        name = "StatusLabel"
        text = "KEITHLEY\n2460"

    Label: relay_led:
        name = "StatusLED"
        text = ""

    Label: relay_lbl:
        name = "StatusLabel"
        text = "RELAY\nMATRIX"

    PushButton: connect_btn:
        text = "Connect"
        clicked :: header.connect_clicked = True

    Label: sample_lbl:
        name = "DimLabel"
        text = "Sample ID:"

    Field: sample_id_field:
        text = "Sample_Batch_01"

    PushButton: browse_dir_btn:
        name = "PrimaryButton"
        text = "Browse..."
        clicked :: header.browse_clicked = True

    PushButton: theme_btn:
        name = "ThemeButton"
        text = "\u2600\ufe0f" if header.is_dark_mode else "\U0001F319"
        clicked :: header.theme_toggled = True
